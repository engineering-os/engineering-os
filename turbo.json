{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "skills/**",
        "skills-cursor/**",
        "skills-codex/**",
        ".claude-plugin/**",
        "plugin.json",
        "scripts/check-native.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    }
  }
}
